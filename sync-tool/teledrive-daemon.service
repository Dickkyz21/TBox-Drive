# File systemd untuk Linux — salin ke /etc/systemd/system/
# Lalu: sudo systemctl enable teledrive-daemon && sudo systemctl start teledrive-daemon

[Unit]
Description=TeleDrive Sync Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%i
ExecStart=/usr/bin/python3 /home/USER/teledrive-simple/sync-tool/daemon.py \
    --folder /home/USER/TeleDrive \
    --url https://NAMA-APP.vercel.app \
    --api-key PASSWORD-KAMU \
    --interval 30 \
    --log-file /home/USER/teledrive-daemon.log
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
